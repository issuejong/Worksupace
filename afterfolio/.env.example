# Gemini free tier (preferred when configured)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini fallback when Groq is not configured (same API key)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional independent fallback (do not paste secrets into git)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional OpenAI alternative
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional shared access token for hosted AI endpoint
AI_ACCESS_TOKEN=
